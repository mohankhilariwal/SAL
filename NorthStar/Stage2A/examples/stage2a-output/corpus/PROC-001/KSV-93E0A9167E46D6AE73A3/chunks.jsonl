{"access":{"allowed_groups":["COMPLIANCE_ANALYST","PAYMENTS_OPERATIONS"],"classification":"INTERNAL","purpose":"REGULATORY_CHANGE_ANALYSIS","residency":"CA"},"business_domains":["PAYMENTS"],"char_count":88,"chunk_id":"CHK-1CD643DC0B8D4609479B","content_sha256":"59870b1fede7ff3dcae87885df5c674ae379452ed9e0585d3fda8d286cd4fa75","effective_from":"2026-05-15","effective_to":null,"heading_path":["Payments Screening Operations","Scope"],"jurisdictions":["CA","US","EU"],"line_end":5,"line_start":3,"ordinal":2,"risk_flags":[],"schema_version":"1.0.0","source_id":"PROC-001","source_version_id":"KSV-93E0A9167E46D6AE73A3","text":"## Scope\nThe process covers domestic and cross-border payment screening before release.\n"}
{"access":{"allowed_groups":["COMPLIANCE_ANALYST","PAYMENTS_OPERATIONS"],"classification":"INTERNAL","purpose":"REGULATORY_CHANGE_ANALYSIS","residency":"CA"},"business_domains":["PAYMENTS"],"char_count":291,"chunk_id":"CHK-436450E2CC619D396BC8","content_sha256":"522b610109d15da27baf38b02b26af07be62c0afc502e42ef98517efbbf2a62b","effective_from":"2026-05-15","effective_to":null,"heading_path":["Payments Screening Operations","Steps"],"jurisdictions":["CA","US","EU"],"line_end":12,"line_start":6,"ordinal":3,"risk_flags":[],"schema_version":"1.0.0","source_id":"PROC-001","source_version_id":"KSV-93E0A9167E46D6AE73A3","text":"## Steps\n1. Receive the payment instruction.\n2. Validate required payer and beneficiary fields.\n3. Screen the transaction against configured rules and lists.\n4. Route potential matches to an authorized operations reviewer.\n5. Record the disposition and evidence before release or rejection.\n"}
{"access":{"allowed_groups":["COMPLIANCE_ANALYST","PAYMENTS_OPERATIONS"],"classification":"INTERNAL","purpose":"REGULATORY_CHANGE_ANALYSIS","residency":"CA"},"business_domains":["PAYMENTS"],"char_count":124,"chunk_id":"CHK-AF2150F85A27DA2BAF33","content_sha256":"d48e66882ca16af295842c8e5c82aeb015de9c34a7bc0423268499753409ed90","effective_from":"2026-05-15","effective_to":null,"heading_path":["Payments Screening Operations","Ownership"],"jurisdictions":["CA","US","EU"],"line_end":14,"line_start":13,"ordinal":4,"risk_flags":[],"schema_version":"1.0.0","source_id":"PROC-001","source_version_id":"KSV-93E0A9167E46D6AE73A3","text":"## Ownership\nPayments Operations owns the process. Compliance owns screening policy. Technology owns the screening platform."}
