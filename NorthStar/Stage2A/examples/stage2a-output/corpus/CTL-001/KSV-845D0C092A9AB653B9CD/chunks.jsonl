{"access":{"allowed_groups":["COMPLIANCE_ANALYST","PRIVACY_CONTROL_OWNER"],"classification":"CONFIDENTIAL","purpose":"REGULATORY_CHANGE_ANALYSIS","residency":"CA"},"business_domains":["CUSTOMER_DATA","PRIVACY"],"char_count":87,"chunk_id":"CHK-573A5D2CF8D182594003","content_sha256":"7da484f4a5fc4ec2da7ae1c14c651c75fb3153c28809e2f73347ada596e85084","effective_from":"2026-04-01","effective_to":null,"heading_path":["Customer Data Sharing Control","Objective"],"jurisdictions":["CA","US","EU"],"line_end":5,"line_start":3,"ordinal":2,"risk_flags":[],"schema_version":"1.0.0","source_id":"CTL-001","source_version_id":"KSV-845D0C092A9AB653B9CD","text":"## Objective\nPrevent unauthorized disclosure or secondary use of customer information.\n"}
{"access":{"allowed_groups":["COMPLIANCE_ANALYST","PRIVACY_CONTROL_OWNER"],"classification":"CONFIDENTIAL","purpose":"REGULATORY_CHANGE_ANALYSIS","residency":"CA"},"business_domains":["CUSTOMER_DATA","PRIVACY"],"char_count":332,"chunk_id":"CHK-4B8F04CA6EBF977C4F6A","content_sha256":"eb6785cce85985ab142f547ba8c61f19842719df6ae4b706d79aa1d29452cf1d","effective_from":"2026-04-01","effective_to":null,"heading_path":["Customer Data Sharing Control","Control activities"],"jurisdictions":["CA","US","EU"],"line_end":10,"line_start":6,"ordinal":3,"risk_flags":[],"schema_version":"1.0.0","source_id":"CTL-001","source_version_id":"KSV-845D0C092A9AB653B9CD","text":"## Control activities\nData-sharing integrations must enforce approved purpose, recipient, jurisdiction, classification, retention period, and revocation requirements.\n\nEvidence must include the approved data-sharing request, authorization result, transferred data categories, transfer timestamp, destination, and exception records.\n"}
{"access":{"allowed_groups":["COMPLIANCE_ANALYST","PRIVACY_CONTROL_OWNER"],"classification":"CONFIDENTIAL","purpose":"REGULATORY_CHANGE_ANALYSIS","residency":"CA"},"business_domains":["CUSTOMER_DATA","PRIVACY"],"char_count":122,"chunk_id":"CHK-9C61CC3B9336F305FC6B","content_sha256":"fa010e72e92ccae866eb554a40ae7c9b2df1feed2b96483021d74c09bf7e388e","effective_from":"2026-04-01","effective_to":null,"heading_path":["Customer Data Sharing Control","Escalation"],"jurisdictions":["CA","US","EU"],"line_end":12,"line_start":11,"ordinal":4,"risk_flags":[],"schema_version":"1.0.0","source_id":"CTL-001","source_version_id":"KSV-845D0C092A9AB653B9CD","text":"## Escalation\nAny transfer outside the approved purpose or geography is escalated to the privacy and cybersecurity owners."}
