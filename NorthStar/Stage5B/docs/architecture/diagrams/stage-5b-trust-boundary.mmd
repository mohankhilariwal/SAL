  end
  subgraph RUNTIME[NorthStar runtime boundary]
    Harness[CMP-003 Harness]
    Regen[INT-053/054 regeneration and compaction]
    Store[Local case memory store]
    Graph[GRAPH-001]
  end
  subgraph EXTERNAL[External authority boundaries]
