{
  "$defs": {
    "fact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "type": "string"
        },
        "field_name": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "authoritative_state",
            "human_decision_reference"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "value": {}
      },
      "required": [
        "fact_id",
        "field_name",
        "value",
        "source",
        "origin"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "case_id",
        "user_id"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_version": {
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "source_version",
        "source_sha256",
        "classification"
      ],
      "type": "object"
    }
  },
  "$id": "https://northstar.example/schemas/DATA-081-CaseWorkingMemoryRecord.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorized_user_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "consent_grant_id": {
      "type": "string"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/fact"
      },
      "maxItems": 64,
      "type": "array"
    },
    "memory_kind": {
      "const": "case_working"
    },
    "purpose": {
      "const": "case_session_continuity"
    },
    "record_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "source_bindings": {
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_snapshot_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "expired",
        "deleted"
      ]
    },
    "supersedes_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "unresolved_questions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "write_request_id": {
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "schema_version",
    "memory_kind",
    "scope",
    "authorized_user_ids",
    "purpose",
    "consent_grant_id",
    "source_snapshot_id",
    "source_bindings",
    "facts",
    "unresolved_questions",
    "created_at",
    "expires_at",
    "status",
    "write_request_id",
    "content_sha256"
  ],
  "title": "DATA-081 CaseWorkingMemoryRecord",
  "type": "object"
}
