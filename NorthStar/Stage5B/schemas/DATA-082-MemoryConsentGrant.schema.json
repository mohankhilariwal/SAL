    },
    "revoked_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    }
  },
  "required": [
    "grant_id",
    "schema_version",
    "scope",
    "purpose",
    "allowed_operations",
    "issued_at",
    "expires_at",
    "acknowledgement"
  ],
  "title": "DATA-082 MemoryConsentGrant",
  "type": "object"
}
