        "enum": [
          "write",
          "read",
          "delete"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "grant_id": {
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "purpose": {
