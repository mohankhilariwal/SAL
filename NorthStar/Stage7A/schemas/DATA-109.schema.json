{
  "$id": "urn:northstar:DATA-109:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_epoch_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "idempotency_key": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "owner_execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "running",
        "succeeded",
        "failed"
      ]
    }
  },
  "required": [
    "idempotency_key",
    "input_digest",
    "state"
  ],
  "title": "IdempotencyRecord",
  "type": "object"
}