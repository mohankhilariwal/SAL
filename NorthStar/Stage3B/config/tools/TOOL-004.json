{
  "schema_version": "1.0.0",
  "version": "1.0.0",
  "allowed_groups": [
    "RegulatoryCompliance"
  ],
  "allowed_purposes": [
    "regulatory-impact-assessment"
  ],
  "allowed_residencies": [
    "CA"
  ],
  "approval_required": false,
  "timeout_ms": 2000,
  "max_result_bytes": 65536,
  "sensitive_input_fields": [],
  "impact_class": "reversible_write",
  "idempotency_required": true,
  "retry_policy": {
    "max_attempts": 1,
    "retryable_errors": []
  },
  "tool_id": "TOOL-004",
  "name": "Create Draft Case",
  "description": "Create one reversible local draft compliance case that remains unapproved.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "publication_id",
      "title",
      "evidence_ids"
    ],
    "properties": {
      "publication_id": {
        "type": "string",
        "pattern": "^[A-Z0-9-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200
      },
      "evidence_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "case_id",
      "status",
      "human_review_required"
    ],
    "properties": {
      "case_id": {
        "type": "string"
      },
      "status": {
        "const": "draft_unapproved"
      },
      "human_review_required": {
        "const": true
      }
    }
  },
  "rate_limit_per_minute": 100,
  "circuit_failure_threshold": 3,
  "circuit_reset_seconds": 30
}
