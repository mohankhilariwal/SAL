{
  "schema_version": "1.0.0",
  "version": "1.0.0",
  "allowed_groups": [
    "RegulatoryCompliance",
    "AIGovernance"
  ],
  "allowed_purposes": [
    "regulatory-impact-assessment"
  ],
  "allowed_residencies": [
    "CA"
  ],
  "approval_required": false,
  "timeout_ms": 2000,
  "max_result_bytes": 65536,
  "sensitive_input_fields": [],
  "tool_id": "TOOL-002",
  "name": "Query Control Catalogue",
  "description": "Query synthetic NorthStar control records within the caller scope.",
  "impact_class": "read_only",
  "idempotency_required": false,
  "retry_policy": {
    "max_attempts": 2,
    "retryable_errors": [
      "transient"
    ]
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query",
      "business_domains",
      "max_results"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 3,
        "maxLength": 300
      },
      "business_domains": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        }
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "controls"
    ],
    "properties": {
      "controls": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control_id",
            "name",
            "business_domain",
            "status"
          ],
          "properties": {
            "control_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "business_domain": {
              "type": "string"
            },
            "status": {
              "const": "active"
            }
          }
        }
      }
    }
  },
  "rate_limit_per_minute": 100,
  "circuit_failure_threshold": 3,
  "circuit_reset_seconds": 30
}
