{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/schemas/tool-descriptor-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "version",
    "name",
    "description",
    "impact_class",
    "input_schema",
    "output_schema",
    "allowed_groups",
    "allowed_purposes",
    "allowed_residencies",
    "approval_required",
    "idempotency_required",
    "retry_policy",
    "timeout_ms",
    "max_result_bytes",
    "sensitive_input_fields",
    "rate_limit_per_minute",
    "circuit_failure_threshold",
    "circuit_reset_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^TOOL-[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "impact_class": {
      "enum": [
        "read_only",
        "reversible_write"
      ]
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "allowed_groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_residencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CA",
          "US",
          "EU"
        ]
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "idempotency_required": {
      "type": "boolean"
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "retryable_errors"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "retryable_errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 10,
      "maximum": 30000
    },
    "max_result_bytes": {
      "type": "integer",
      "minimum": 128,
      "maximum": 1000000
    },
    "sensitive_input_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "rate_limit_per_minute": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "circuit_failure_threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "circuit_reset_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    }
  }
}
