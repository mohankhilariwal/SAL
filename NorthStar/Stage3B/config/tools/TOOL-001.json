{
  "schema_version": "1.0.0",
  "version": "1.0.0",
  "allowed_groups": [
    "RegulatoryCompliance",
    "AIGovernance"
  ],
  "allowed_purposes": [
    "regulatory-impact-assessment"
  ],
  "allowed_residencies": [
    "CA"
  ],
  "approval_required": false,
  "timeout_ms": 2000,
  "max_result_bytes": 65536,
  "sensitive_input_fields": [],
  "tool_id": "TOOL-001",
  "name": "Search Regulatory Catalogue",
  "description": "Search the approved local regulatory publication catalogue.",
  "impact_class": "read_only",
  "idempotency_required": false,
  "retry_policy": {
    "max_attempts": 2,
    "retryable_errors": [
      "transient"
    ]
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query",
      "jurisdictions",
      "max_results"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 3,
        "maxLength": 300
      },
      "jurisdictions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        }
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "records"
    ],
    "properties": {
      "records": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publication_id",
            "title",
            "jurisdiction",
            "authority"
          ],
          "properties": {
            "publication_id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "authority": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "rate_limit_per_minute": 100,
  "circuit_failure_threshold": 3,
  "circuit_reset_seconds": 30
}
