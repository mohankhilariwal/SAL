{
  "allowed_groups": [
    "regulatory_analysts",
    "ai_governance"
  ],
  "allowed_purposes": [
    "regulatory_change_assessment"
  ],
  "allowed_residencies": [
    "CA",
    "US",
    "EU"
  ],
  "approval_required": false,
  "description": "Persist a candidate policy-and-control mapping against an existing unapproved draft case. The output is always candidate, unaccepted and human-review required; the tool cannot create a final gap, obligation or compliance disposition.",
  "idempotency_required": true,
  "impact_class": "reversible_write",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "case_id": {
        "pattern": "^CASE-DRAFT-",
        "type": "string"
      },
      "control_ids": {
        "items": {
          "maxLength": 80,
          "minLength": 3,
          "type": "string"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array"
      },
      "policy_id": {
        "maxLength": 80,
        "minLength": 3,
        "type": "string"
      },
      "rationale": {
        "maxLength": 2000,
        "minLength": 10,
        "type": "string"
      },
      "source_citation_ids": {
        "items": {
          "pattern": "^CIT-",
          "type": "string"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "case_id",
      "policy_id",
      "control_ids",
      "source_citation_ids",
      "rationale"
    ],
    "type": "object"
  },
  "max_result_bytes": 8192,
  "name": "save_candidate_mapping",
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "accepted": {
        "const": false
      },
      "case_id": {
        "pattern": "^CASE-DRAFT-",
        "type": "string"
      },
      "created": {
        "type": "boolean"
      },
      "human_review_required": {
        "const": true
      },
      "mapping_id": {
        "pattern": "^MAP-CAND-",
        "type": "string"
      },
      "status": {
        "const": "CANDIDATE_UNAPPROVED"
      }
    },
    "required": [
      "mapping_id",
      "case_id",
      "status",
      "accepted",
      "human_review_required",
      "created"
    ],
    "type": "object"
  },
  "retry_policy": {
    "max_attempts": 1,
    "retryable_errors": []
  },
  "schema_version": "1.0.0",
  "sensitive_input_fields": [],
  "timeout_ms": 500,
  "tool_id": "TOOL-005",
  "version": "1.0.0"
}
