{"access": {"allowed_groups": ["COMPLIANCE_ANALYST", "PAYMENTS_OPERATIONS"], "classification": "INTERNAL", "purpose": "REGULATORY_CHANGE_ANALYSIS", "residency": "CA"}, "authoritative": true, "business_domains": ["PAYMENTS", "FINANCIAL_CRIME"], "chunk_id": "CHK-B1253E026C790E24759F", "effective_from": "2026-02-15", "effective_to": null, "heading_path": ["Payments Screening and Escalation Process"], "jurisdictions": ["CA", "US", "EU"], "line_end": 2, "line_start": 1, "normalized_source_sha256": "237c52015bd13bd61b149f4abde11efedf915ad797f1684e8a6d571ff8dcf9a1", "owner": "Payments Operations Owner", "risk_flags": [], "schema_version": "1.0.0", "source_id": "PROC-001", "source_type": "PROCESS", "source_version_id": "KSV-3CD13C57F3A62D76108E", "text": "# Payments Screening and Escalation Process\n", "text_sha256": "e13d552810c0904d4e2ce36e758a7f966b2543d1ce65e52d3200302db3e50582", "title": "Payments Screening and Escalation Process", "version_label": "2026.3"}
{"access": {"allowed_groups": ["COMPLIANCE_ANALYST", "PAYMENTS_OPERATIONS"], "classification": "INTERNAL", "purpose": "REGULATORY_CHANGE_ANALYSIS", "residency": "CA"}, "authoritative": true, "business_domains": ["PAYMENTS", "FINANCIAL_CRIME"], "chunk_id": "CHK-27936953C3668CA2BF72", "effective_from": "2026-02-15", "effective_to": null, "heading_path": ["Payments Screening and Escalation Process", "Pre-execution screening"], "jurisdictions": ["CA", "US", "EU"], "line_end": 6, "line_start": 3, "normalized_source_sha256": "237c52015bd13bd61b149f4abde11efedf915ad797f1684e8a6d571ff8dcf9a1", "owner": "Payments Operations Owner", "risk_flags": [], "schema_version": "1.0.0", "source_id": "PROC-001", "source_type": "PROCESS", "source_version_id": "KSV-3CD13C57F3A62D76108E", "text": "## Pre-execution screening\nPayments must be screened against applicable sanctions, restricted-party and high-risk jurisdiction rules before release.\nPotential matches are held for review; the process must not silently bypass a screening result.\n", "text_sha256": "129c91370b591afeeef1c838bf407e9f54fb1514613315dbd3a48a30fe196ead", "title": "Payments Screening and Escalation Process", "version_label": "2026.3"}
{"access": {"allowed_groups": ["COMPLIANCE_ANALYST", "PAYMENTS_OPERATIONS"], "classification": "INTERNAL", "purpose": "REGULATORY_CHANGE_ANALYSIS", "residency": "CA"}, "authoritative": true, "business_domains": ["PAYMENTS", "FINANCIAL_CRIME"], "chunk_id": "CHK-CD2417A03DE0A74BC4C7", "effective_from": "2026-02-15", "effective_to": null, "heading_path": ["Payments Screening and Escalation Process", "Transaction monitoring"], "jurisdictions": ["CA", "US", "EU"], "line_end": 10, "line_start": 7, "normalized_source_sha256": "237c52015bd13bd61b149f4abde11efedf915ad797f1684e8a6d571ff8dcf9a1", "owner": "Payments Operations Owner", "risk_flags": [], "schema_version": "1.0.0", "source_id": "PROC-001", "source_type": "PROCESS", "source_version_id": "KSV-3CD13C57F3A62D76108E", "text": "## Transaction monitoring\nPost-execution transaction monitoring identifies unusual patterns, structuring indicators and repeated threshold avoidance.\nA material alert is escalated to Payments Compliance with transaction evidence, customer context and the screening disposition.\n", "text_sha256": "50614f49565f34dc3778c7923b3959049acdfed70a4e7755529a87e5f8a7aa21", "title": "Payments Screening and Escalation Process", "version_label": "2026.3"}
{"access": {"allowed_groups": ["COMPLIANCE_ANALYST", "PAYMENTS_OPERATIONS"], "classification": "INTERNAL", "purpose": "REGULATORY_CHANGE_ANALYSIS", "residency": "CA"}, "authoritative": true, "business_domains": ["PAYMENTS", "FINANCIAL_CRIME"], "chunk_id": "CHK-E92DA6A1695B8387A8D4", "effective_from": "2026-02-15", "effective_to": null, "heading_path": ["Payments Screening and Escalation Process", "Operational recovery"], "jurisdictions": ["CA", "US", "EU"], "line_end": 12, "line_start": 11, "normalized_source_sha256": "237c52015bd13bd61b149f4abde11efedf915ad797f1684e8a6d571ff8dcf9a1", "owner": "Payments Operations Owner", "risk_flags": [], "schema_version": "1.0.0", "source_id": "PROC-001", "source_type": "PROCESS", "source_version_id": "KSV-3CD13C57F3A62D76108E", "text": "## Operational recovery\nIf the screening service is unavailable, the payment remains queued or follows the approved manual contingency; it is not automatically released.", "text_sha256": "116c990f0ed421a2823d51294a275e0ea3ae54eacd97f198655c51f12cd01321", "title": "Payments Screening and Escalation Process", "version_label": "2026.3"}
