{"access": {"allowed_groups": ["COMPLIANCE_ANALYST", "LENDING_POLICY_OWNER"], "classification": "CONFIDENTIAL", "purpose": "REGULATORY_CHANGE_ANALYSIS", "residency": "CA"}, "authoritative": true, "business_domains": ["LENDING", "CUSTOMER_OUTCOMES"], "chunk_id": "CHK-35AF41E4E4C19BA77D65", "effective_from": "2026-01-01", "effective_to": null, "heading_path": ["Responsible Lending Policy"], "jurisdictions": ["CA", "US"], "line_end": 2, "line_start": 1, "normalized_source_sha256": "84f4d8f16707d60b8a44c4fbc8714573437d962e7381a3a02d2f8deb93d86a82", "owner": "Lending Policy Owner", "risk_flags": [], "schema_version": "1.0.0", "source_id": "POL-001", "source_type": "POLICY", "source_version_id": "KSV-0921CE196D63A7CE6773", "text": "# Responsible Lending Policy\n", "text_sha256": "5f45bc9e6447856d85a032aaf7663ad0464d457865ebe2fca52910e90326b5d5", "title": "Responsible Lending Policy", "version_label": "2026.1"}
{"access": {"allowed_groups": ["COMPLIANCE_ANALYST", "LENDING_POLICY_OWNER"], "classification": "CONFIDENTIAL", "purpose": "REGULATORY_CHANGE_ANALYSIS", "residency": "CA"}, "authoritative": true, "business_domains": ["LENDING", "CUSTOMER_OUTCOMES"], "chunk_id": "CHK-38C89BC4EA14B5EBAE95", "effective_from": "2026-01-01", "effective_to": null, "heading_path": ["Responsible Lending Policy", "Affordability and ability to repay"], "jurisdictions": ["CA", "US"], "line_end": 8, "line_start": 3, "normalized_source_sha256": "84f4d8f16707d60b8a44c4fbc8714573437d962e7381a3a02d2f8deb93d86a82", "owner": "Lending Policy Owner", "risk_flags": [], "schema_version": "1.0.0", "source_id": "POL-001", "source_type": "POLICY", "source_version_id": "KSV-0921CE196D63A7CE6773", "text": "## Affordability and ability to repay\nNorthStar must assess a borrower's ability to repay before approving or materially increasing a lending facility.\nThe assessment must consider verified income, committed expenses, existing debt obligations and reasonably foreseeable payment stress.\nAn automated recommendation may support the analysis, but it must not replace the accountable lending decision.\nEvidence of the assessment and any exception must be retained with the application record.\n", "text_sha256": "ed521a8724d00ffd3acb616a93264c0844bc5e2043f031ded715dc0f2bab6f3b", "title": "Responsible Lending Policy", "version_label": "2026.1"}
{"access": {"allowed_groups": ["COMPLIANCE_ANALYST", "LENDING_POLICY_OWNER"], "classification": "CONFIDENTIAL", "purpose": "REGULATORY_CHANGE_ANALYSIS", "residency": "CA"}, "authoritative": true, "business_domains": ["LENDING", "CUSTOMER_OUTCOMES"], "chunk_id": "CHK-C9EC10F30EDCB5DC8DBF", "effective_from": "2026-01-01", "effective_to": null, "heading_path": ["Responsible Lending Policy", "Vulnerable customers and adverse outcomes"], "jurisdictions": ["CA", "US"], "line_end": 11, "line_start": 9, "normalized_source_sha256": "84f4d8f16707d60b8a44c4fbc8714573437d962e7381a3a02d2f8deb93d86a82", "owner": "Lending Policy Owner", "risk_flags": [], "schema_version": "1.0.0", "source_id": "POL-001", "source_type": "POLICY", "source_version_id": "KSV-0921CE196D63A7CE6773", "text": "## Vulnerable customers and adverse outcomes\nAnalysts must identify indicators of financial vulnerability and avoid practices that could create unfair or unsustainable outcomes.\nMaterial policy exceptions require named human review and documented rationale.", "text_sha256": "1bc418adeec615bd20d783b23f27b46bad78ad4c43928497f9510f8090c7a3b0", "title": "Responsible Lending Policy", "version_label": "2026.1"}
