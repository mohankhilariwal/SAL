{
  "$id": "DATA-063",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "const": "AGT-001"
    },
    "agent_version": {
      "type": "string"
    },
    "architecture_version": {
      "const": "1.0.0"
    },
    "concurrent_graph_branches": {
      "const": false
    },
    "critical_controls_external": {
      "const": true
    },
    "graph_id": {
      "const": "GRAPH-001"
    },
    "graph_version": {
      "const": "1.1.0"
    },
    "hook_names": {
      "type": "array",
      "uniqueItems": true
    },
    "instruction_name": {
      "type": "string"
    },
    "instruction_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "instruction_version": {
      "type": "string"
    },
    "memory_enabled": {
      "const": false
    },
    "multiple_agents_enabled": {
      "const": false
    },
    "repository_version": {
      "const": "1.0.0"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "tool_versions": {
      "required": [
        "TOOL-001",
        "TOOL-002",
        "TOOL-003",
        "TOOL-004",
        "TOOL-005",
        "TOOL-006"
      ],
      "type": "object"
    },
    "validator_names": {
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "architecture_version",
    "repository_version",
    "agent_id",
    "agent_version",
    "graph_id",
    "graph_version",
    "tool_versions",
    "instruction_name",
    "instruction_version",
    "instruction_sha256",
    "validator_names",
    "hook_names",
    "memory_enabled",
    "concurrent_graph_branches",
    "multiple_agents_enabled",
    "critical_controls_external"
  ],
  "title": "DATA-063 HarnessManifest",
  "type": "object"
}
