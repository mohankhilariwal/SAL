{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "DATA-097 HandoffStatusEvent",
  "type": "object",
  "required": [
    "event_id",
    "envelope_id",
    "task_id",
    "actor_id",
    "status",
    "occurred_at",
    "reason_code",
    "digest_sha256"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "envelope_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "previous_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "offered",
        "accepted",
        "running",
        "completed",
        "rejected",
        "failed",
        "cancel_requested",
        "cancelled",
        "expired"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string"
    },
    "digest_sha256": {
      "type": "string"
    }
  }
}
