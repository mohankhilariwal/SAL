{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/schemas/DATA-103.schema.json",
  "title": "VersionNegotiationRecord",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "negotiation_id",
    "protocol_name",
    "local_supported",
    "remote_supported",
    "result"
  ],
  "properties": {
    "negotiation_id": {
      "type": "string"
    },
    "protocol_name": {
      "type": "string"
    },
    "local_supported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remote_supported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string"
    }
  }
}
