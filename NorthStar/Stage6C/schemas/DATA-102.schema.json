{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/schemas/DATA-102.schema.json",
  "title": "CapabilityAdvertisement",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "advertisement_id",
    "endpoint_id",
    "endpoint_version",
    "endpoint_digest",
    "protocol_profiles",
    "skills",
    "expires_at"
  ],
  "properties": {
    "advertisement_id": {
      "type": "string"
    },
    "endpoint_id": {
      "type": "string"
    },
    "endpoint_version": {
      "type": "string"
    },
    "endpoint_digest": {
      "type": "string"
    },
    "protocol_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "string"
    }
  }
}
