    "profile_id": {
      "type": "string"
    },
    "endpoint_id": {
      "type": "string"
    },
    "schema_digests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_target": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}
